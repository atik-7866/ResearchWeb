APP_ENV=development
APP_NAME=ResearchGraph
LOG_LEVEL=INFO
API_PORT=8000

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=your-neo4j-user
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=your-neo4j-database

QDRANT_HOST=your-cluster.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_HTTPS=true
QDRANT_COLLECTION=papers

OPENALEX_POLITE_EMAIL=you@example.com
OPENALEX_BASE_URL=https://api.openalex.org

INGEST_DEFAULT_TOPIC=retrieval augmented generation
INGEST_DEFAULT_LIMIT=200

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
